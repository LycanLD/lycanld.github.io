<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Lyc4n's FAQ</title>
</head>
<body>
    <h1>Am I a furry?</h1>
    <p id="bigNo" style="font-size: 80px; font-weight: bold; font-family: monospace;">No</p>
    <p><small>(try to change it to yes)</small></p>

    <script>
        const el = document.getElementById('bigNo');
        let caught = false;

        function bust() {
            if (caught) return;
            caught = true;
            alert("BUSTED! :3. I'm always steps ahead of ya.");
            el.innerHTML = "YOU ARE A FURRY NOW, :3.<br><span style='font-size:40px;'>No takebacks. >w< </span>";
            el.style.fontSize = "50px";
        }

        function checkAndBust() {
            if (!caught && el.innerText.trim().toLowerCase() === 'yes') {
                bust();
            } else if (caught && el.innerText.trim().toLowerCase() === 'yes') {
                alert("Still a furry. Stop trying.");
                el.innerHTML = "STILL A FURRY. GIVE UP.";
                el.style.fontSize = "40px";
            }
        }

        const observer = new MutationObserver(() => {
            checkAndBust();
        });

        observer.observe(el, { 
            childList: true, 
            characterData: true, 
            subtree: true 
        });
        checkAndBust();
    </script>
</body>
</html>
